// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  subtitle    String?
  summary     String
  description String
  tags        String?
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  themeColor  String?
  featured    Boolean  @default(false)
  order       Int       @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GithubHighlight {
  id             String   @id @default(uuid())
  title          String
  subtitle       String?
  description    String
  repoUrl        String
  githubSlug     String?
  language       String?
  stars          Int      @default(0)
  highlightColor String?
  imageUrl       String?
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
